<%#
# HasOne Show Partial

This partial renders a has_one relationship,
to be displayed on a resource's show page.

## Local variables:

- `field`:
  An instance of [Administrate::Field::HasOne][1].
  A wrapper around the has_one relationship pulled from the database.

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Field/HasOne
%>

<% if field.data %>
  <% if accessible_action?(field.data, :show) %>
    <%= link_to(
      field.display_associated_resource,
      polymorphic_path([:admin, field.data]),
      class: "text-indigo-600 hover:text-indigo-900 underline"
    ) %>
  <% else %>
    <span class="text-gray-900"><%= field.display_associated_resource %></span>
  <% end %>
<% else %>
  <span class="text-gray-500 italic">No associated record</span>
<% end %>
