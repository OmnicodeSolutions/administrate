<% if existing_action?(collection_presenter.resource_name, :edit) %>
  <td>
    <% if accessible_action?(resource, :edit) %>
      <%= render "administrate/application/button",
          text: t("administrate.actions.edit"),
          href: [:edit, namespace, resource],
          variant: "white" %>
    <% end %>
  </td>
<% end %>

<% if existing_action?(collection_presenter.resource_name, :destroy) %>
  <td>
    <% if accessible_action?(resource, :destroy) %>
      <%= render "administrate/application/button",
          text: t("administrate.actions.destroy"),
          href: [namespace, resource],
          variant: "danger",
          data: { 
            confirm: t("administrate.actions.confirm"),
            turbo_method: :delete
          } %>
    <% end %>
  </td>
<% end %>
