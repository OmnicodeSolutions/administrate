<%#
# Card Component

This component renders a card container with consistent styling.

## Local variables:

- `title`: Optional card title
- `class`: Additional CSS classes
- `padding`: Padding variant (default, compact, none)
%>

<%
  # Default values
  padding ||= 'default'
  
  # Base styles
  base_styles = "bg-white border border-gray-200 rounded-lg shadow-sm"
  
  # Padding variants
  padding_styles = case padding
  when 'compact'
    "p-4"
  when 'none'
    ""
  else
    "p-6"
  end
  
  # Combine styles
  card_styles = "#{base_styles} #{padding_styles}"
  
  # Additional classes
  additional_classes = local_assigns[:class] || ""
  final_classes = "#{card_styles} #{additional_classes}".strip
%>

<div class="<%= final_classes %>">
  <% if local_assigns[:title].present? %>
    <div class="border-b border-gray-200 pb-4 mb-4">
      <h3 class="text-lg font-medium text-gray-900"><%= title %></h3>
    </div>
  <% end %>
  
  <%= yield %>
</div> 