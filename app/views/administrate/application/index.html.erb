<%#
# Index

This view is the template for the index page.
It is responsible for rendering the search bar, header and pagination.
It renders the `_table` partial to display details about the resources.

## Local variables:

- `page`:
  An instance of [Administrate::Page::Collection][1].
  Contains helper methods to help display a table,
  and knows which attributes should be displayed in the resource's table.
- `resources`:
  An instance of `ActiveRecord::Relation` containing the resources
  that match the user's search criteria.
  By default, these resources are passed to the table partial to be displayed.
- `search_term`:
  A string containing the term the user has searched for, if any.
- `show_search_bar`:
  A boolean that determines if the search bar should be shown.

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Collection
%>

<% content_for(:title) { t("administrate.controller.index.title", resource: page.resource_name.pluralize.titleize) } %>

<!-- Search bar for header -->
<% content_for(:search_bar) do %>
  <% if show_search_bar %>
    <%= form_with(url: request.path, method: :get, class: "w-full max-w-lg lg:max-w-xs", data: { turbo_frame: "_top" }) do |f| %>
      <label for="search" class="sr-only">Search</label>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center">
          <button type="submit" class="bg-none border-none p-0 cursor-pointer flex items-center justify-center text-inherit transition-all duration-200 ease-in-out hover:scale-105 focus:outline-2 focus:outline-blue-500 focus:outline-offset-2 focus:rounded" aria-label="Search">
            <svg class="h-4 w-4 text-gray-400 hover:text-blue-500 transition-colors duration-200" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
        </div>
        <%= f.text_field :search, 
          value: search_term,
          placeholder: t("administrate.search.placeholder", resource: page.resource_name.pluralize.titleize),
          class: "block w-full pl-10 pr-8 py-2 border border-secondary-300 rounded-md leading-5 bg-white placeholder-secondary-500 focus:outline-none focus:placeholder-secondary-400 focus:ring-1 focus:ring-primary-500 focus:border-primary-500 sm:text-sm",
          autocomplete: "off" %>
        <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
          <%= link_to request.path + "?#{request.query_parameters.except(:search).to_query}", 
              class: "bg-none border-none p-0 cursor-pointer flex items-center justify-center text-inherit transition-all duration-200 ease-in-out hover:scale-105 focus:outline-2 focus:outline-red-500 focus:outline-offset-2 focus:rounded", 
              aria_label: "Clear search",
              data: { turbo_method: :get, turbo_frame: "_top" } do %>
            <svg class="h-4 w-4 text-gray-400 hover:text-red-500 transition-colors duration-200" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

<!-- Header actions -->
<% content_for(:header_actions) do %>
  <% if accessible_action?(page.resource_class, :new) %>
    <% 
      # Handle nested namespaces properly
      # The resource name might be "blog/post" instead of "blog__post"
      resource_name_str = page.resource_name.to_s
      if resource_name_str.include?("/")
        # Handle "blog/post" format
        resource_parts = resource_name_str.split("/")
      else
        # Handle "blog__post" format
        resource_parts = resource_name_str.split("__")
      end
      
      # Generate the route helper name
      route_helper_name = "new_#{namespace}_#{resource_parts.join('_')}_path"
    %>
    <%= render "administrate/application/button",
        text: t("administrate.actions.new_resource", name: page.resource_name.titleize),
        href: send(route_helper_name),
        variant: "white" %>
  <% end %>
<% end %>

<div class="space-y-6">
  <!-- Page header -->
  <div class="border-b border-gray-200 pb-4">
    <h1 class="text-2xl font-bold text-gray-900"><%= content_for(:title) %></h1>
  </div>

  <!-- Collection table -->
  <%= render(
    "collection",
    collection_presenter: page,
    collection_field_name: resource_name,
    page: page,
    resources: resources,
    table_title: "page-title",
    show_pagination: true
  ) %>
</div>
