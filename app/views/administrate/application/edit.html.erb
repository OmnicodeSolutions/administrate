<%#
# Edit

This view is the template for the edit page.

It displays a header, and renders the `_form` partial to do the heavy lifting.

## Local variables:

- `page`:
  An instance of [Administrate::Page::Form][1].
  Contains helper methods to help display a form,
  and knows which attributes should be displayed in the resource's form.

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Form
%>

<% content_for(:title) { t("administrate.actions.edit_resource", name: page.page_title) } %>

<% content_for(:header_actions) do %>
  <%= render "administrate/application/button",
    text: t("administrate.actions.show_resource", name: page.page_title),
    href: [namespace, page.resource],
    variant: "white",
    data: { turbo_frame: "_top" } %>
<% end %>

<div class="space-y-6">
  <div class="border-b border-gray-200 pb-4">
    <h1 id="page-title" class="text-2xl font-bold text-gray-900"><%= content_for(:title) %></h1>
    <p class="mt-2 text-sm text-gray-600">
      <%= t("administrate.controller.edit.subtitle", resource: display_resource_name(page.resource_name, singular: true)) %>
    </p>
  </div>

  <div class="administrate-card">
    <%= render "form", page: page %>
  </div>
</div>
