<%#
# Field Component

This component renders a form field with label and input.

## Local variables:

- `label`: The field label
- `required`: Whether the field is required
- `hint`: Optional hint text
- `error`: Optional error message
- `class`: Additional CSS classes
- `field_class`: The field type class (string, boolean, etc.)
%>

<%
  # Default values
  required ||= false
  field_class ||= 'string'
  
  # Base styles
  base_styles = "flex flex-col gap-1"
  
  # Additional classes
  additional_classes = local_assigns[:class] || ""
  final_classes = "#{base_styles} #{additional_classes}".strip
%>

<div class="<%= final_classes %> field-unit field-unit--<%= field_class %>">
  <div class="field-unit__label">
    <label class="block text-sm font-medium text-gray-700 mb-1">
      <%= label %>
      <% if required %>
        <span class="text-red-500">*</span>
      <% end %>
    </label>
  </div>
  
  <div class="field-unit__field">
    <%= yield %>
    
    <% if local_assigns[:hint].present? %>
      <p class="mt-1 text-sm text-gray-500 field-unit__hint"><%= hint %></p>
    <% end %>
    
    <% if local_assigns[:error].present? %>
      <p class="mt-1 text-sm text-red-600"><%= error %></p>
    <% end %>
  </div>
</div> 