<%#
# Flash Partial

This partial renders flash messages on every page.

## Relevant Helpers:

- `flash`:
  Returns a hash,
  where the keys are the type of flash (alert, error, notice, etc)
  and the values are the message to be displayed.
%>

<% if flash.any? %>
  <script>
    function dismissFlash(button) {
      var flashElement = button.closest('[role="alert"]');
      if (flashElement) {
        flashElement.style.transition = "all 0.3s ease-out";
        flashElement.style.opacity = "0";
        flashElement.style.transform = "translateY(-10px)";
        flashElement.style.marginBottom = "0";
        
        setTimeout(function() {
          flashElement.remove();
        }, 300);
      }
    }
  </script>
  <div class="px-4 sm:px-6 md:px-8">
    <% flash.each do |key, value| -%>
      <% next unless value.respond_to?(:html_safe) %>
      <% 
        case key.to_s
        when 'notice', 'success'
          bg_color = 'bg-green-50 dark:bg-gray-800'
          text_color = 'text-green-800 dark:text-green-400'
          title_color = 'text-green-800 dark:text-green-400'
        when 'alert', 'warning'
          bg_color = 'bg-yellow-50 dark:bg-gray-800'
          text_color = 'text-yellow-800 dark:text-yellow-300'
          title_color = 'text-yellow-800 dark:text-yellow-300'
        when 'error'
          bg_color = 'bg-red-50 dark:bg-gray-800'
          text_color = 'text-red-800 dark:text-red-400'
          title_color = 'text-red-800 dark:text-red-400'
        else
          bg_color = 'bg-blue-50 dark:bg-gray-800'
          text_color = 'text-blue-800 dark:text-blue-400'
          title_color = 'text-blue-800 dark:text-blue-400'
        end
      %>
      <div class="p-4 mb-4 text-sm <%= bg_color %> <%= text_color %> rounded-lg transition-all duration-300 ease-in-out"
           role="alert"
           data-controller="flash"
           data-flash-auto-dismiss-value="true"
           data-flash-delay-value="5000">
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <span class="font-medium"><%= value.html_safe %></span>
          </div>
          <button onclick="dismissFlash(this)"
                  class="ml-4 text-gray-400 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 rounded transition-colors duration-200">
            <span class="sr-only">Dismiss</span>
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    <% end -%>
  </div>
<% end %>
