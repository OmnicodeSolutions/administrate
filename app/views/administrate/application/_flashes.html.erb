<%#
# Flash Partial

This partial renders flash messages on every page.

## Relevant Helpers:

- `flash`:
  Returns a hash,
  where the keys are the type of flash (alert, error, notice, etc)
  and the values are the message to be displayed.
%>

<% if flash.any? %>
  <div class="space-y-4 mb-6">
    <% flash.each do |key, value| -%>
      <% next unless value.respond_to?(:html_safe) %>
      <% flash_class = case key.to_s
           when 'notice', 'success' then 'admin-flash-success flash-notice'
           when 'error', 'alert' then 'admin-flash-error flash-error'
           when 'warning' then 'admin-flash-warning flash-warning'
           else 'admin-flash-info flash-info'
           end %>
      <div class="<%= flash_class %>"><%= value.html_safe %></div>
    <% end -%>
  </div>
<% end %>
