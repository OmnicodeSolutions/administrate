<%#
# Collection

This partial is used on the `index` and `show` pages
to display a collection of resources in an HTML table.

## Local variables:

- `collection_presenter`:
  An instance of [Administrate::Page::Collection][1].
  The table presenter uses `ResourceDashboard::COLLECTION_ATTRIBUTES` to determine
  the columns displayed in the table
- `resources`:
  An ActiveModel::Relation collection of resources to be displayed in the table.
  By default, the number of resources is limited by pagination
  or by a hard limit to prevent excessive page load times
- `show_pagination`:
  A boolean that determines if pagination should be shown at the bottom of the table.
  Defaults to true.
- `param_name`:
  The parameter name to use for pagination links. Defaults to "_page".
  For has_many associations, this is typically "#{field.name}[page]".

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Collection
%>

<% show_pagination = local_assigns.fetch(:show_pagination, true) %>

<div class="bg-white border border-secondary-200 rounded-lg shadow">
  <table class="min-w-full divide-y divide-gray-200" aria-labelledby="<%= table_title %>" data-controller="table">
          <thead class="bg-secondary-50">
      <tr>
        <% collection_presenter.attribute_types.each do |attr_name, attr_type| %>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider <%= attr_type.html_class %> <%= collection_presenter.ordered_html_class(attr_name) %>"
              scope="col"
              aria-sort="<%= sort_order(collection_presenter.ordered_html_class(attr_name)) %>">
            <%= link_to(
              sanitized_order_params(page, collection_field_name).merge(
                collection_presenter.order_params_for(attr_name, key: collection_field_name)
              ),
              class: "flex items-center space-x-1 hover:text-blue-600 transition-colors duration-200"
            ) do %>
              <span><%= t(
                "helpers.label.#{collection_presenter.resource_name}.#{attr_name}",
                default: resource_class.human_attribute_name(attr_name).titleize,
              ) %></span>
              <span class="sort-arrow <%= 'hidden' unless collection_presenter.ordered_by?(attr_name) %>">
                <svg class="w-4 h-4" style="transform: <%= 'rotate(180deg)' if collection_presenter.ordered_html_class(attr_name) == :desc %>;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            <% end %>
          </th>
        <% end %>
        <%= render(
          "collection_header_actions",
          collection_presenter: collection_presenter,
          page: page,
          resources: resources,
          table_title: "page-title"
        ) %>
      </tr>
    </thead>

    <tbody class="bg-white divide-y divide-secondary-200">
      <% resources.each do |resource| %>
        <tr class="cursor-pointer transition-colors duration-200"
            data-table-target="row"
            <% if accessible_action?(resource, :show) %>
              tabindex="0" 
              role="link" 
              data-url="<%= polymorphic_path([namespace, resource]) %>"
              aria-label="<%= t('administrate.actions.show_resource', name: display_resource_name(collection_presenter.resource_name, singular: true)) %>"
            <% end %>
            >
          <% collection_presenter.attributes_for(resource).each do |attribute| %>
            <td class="<%= attribute.html_class %> p-4 text-sm text-gray-900 border-b border-gray-200 break-words whitespace-normal align-top">
              <% if accessible_action?(resource, :show) && !render_field(attribute).include?("<a") -%>
                <a href="<%= polymorphic_path([namespace, resource]) -%>"
                   tabindex="-1"
                   class="block text-gray-900 hover:text-blue-600 transition-colors duration-200"
                   data-turbo-frame="_top">
                  <%= render_field attribute %>
                </a>
              <% else %>
                <div class="text-gray-900">
                  <%= render_field attribute %>
                </div>
              <% end -%>
            </td>
          <% end %>

          <%= render(
            "collection_item_actions",
            collection_presenter: collection_presenter,
            collection_field_name: collection_field_name,
            page: page,
            namespace: namespace,
            resource: resource,
            table_title: "page-title"
          ) %>
        </tr>
      <% end %>
    </tbody>

    <% if show_pagination && resources.respond_to?(:current_page) %>
      <tfoot>
        <tr>
          <td colspan="100%" class="border-t border-gray-200 p-4">
            <div class="flex items-center justify-between py-3 bg-white rounded-b-lg">
              <div class="text-sm text-gray-700">
                Page <%= resources.current_page %> of <%= resources.total_pages %>
              </div>
              <div class="flex gap-6">
                <% param_name = local_assigns.fetch(:param_name, "_page") %>
                <% if resources.prev_page %>
                  <%= render "administrate/application/button",
                      text: "Previous",
                      href: url_for(request.params.merge(param_name => resources.prev_page)),
                      variant: "white" %>
                <% else %>
                  <%= render "administrate/application/button",
                      text: "Previous",
                      variant: "white",
                      disabled: true %>
                <% end %>
                <% if resources.next_page %>
                  <%= render "administrate/application/button",
                      text: "Next",
                      href: url_for(request.params.merge(param_name => resources.next_page)),
                      variant: "white" %>
                <% else %>
                  <%= render "administrate/application/button",
                      text: "Next",
                      variant: "white",
                      disabled: true %>
                <% end %>
              </div>
            </div>
          </td>
        </tr>
      </tfoot>
    <% end %>
  </table>
</div>
