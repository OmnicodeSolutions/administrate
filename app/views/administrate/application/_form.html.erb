<%#
# Form Partial

This partial is rendered on a resource's `new` and `edit` pages,
and renders all form fields for a resource's editable attributes.

## Local variables:

- `page`:
  An instance of [Administrate::Page::Form][1].
  Contains helper methods to display a form,
  and knows which attributes should be displayed in the resource's form.

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Form
%>

<%= form_for([namespace, page.resource], html: { class: "space-y-6" }, data: { turbo: true }) do |f| %>
  <% if page.resource.errors.any? %>
    <div class="administrate-flash administrate-flash--error">
      <div class="flex items-start">
        <svg class="w-4 h-4 mr-2 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <h3 class="font-medium">
            <%= t(
              "administrate.form.errors",
              pluralized_errors: pluralize(page.resource.errors.count, t("administrate.form.error")),
              resource_name: display_resource_name(page.resource_name, singular: true)
            ) %>
          </h3>
          <ul class="mt-2 text-sm list-disc list-inside space-y-1">
            <% page.resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <% page.attributes(controller.action_name).each do |title, attributes| -%>
    <div class="<%= 'administrate-card p-6' if title.present? %>">
      <% if title.present? %>
        <h3 class="text-lg font-medium text-gray-900 mb-4">
          <%= t "helpers.label.#{f.object_name}.#{title}", default: title %>
        </h3>
      <% end %>

      <div class="space-y-6">
        <% attributes.each do |attribute| %>
          <div class="field-unit field-unit--<%= attribute.html_class %> <%= 'required' if requireness(attribute) == 'required' %>"
               data-controller="<%= 'datepicker' if %w[date time datetime].include?(attribute.html_class) %> <%= 'select' if %w[select belongs-to has-many polymorphic].include?(attribute.html_class) %>"
               <% if %w[date time datetime].include?(attribute.html_class) %>
                 data-datepicker-type-value="<%= attribute.html_class %>"
               <% end %>
               <% if %w[select belongs-to has-many polymorphic].include?(attribute.html_class) %>
                 data-select-multiple-value="<%= attribute.html_class == 'has-many' %>"
                 data-select-searchable-value="true"
               <% end %>>
            <%= render_field attribute, f: f %>

            <% hint_key = "administrate.field_hints.#{page.resource_name}.#{attribute.name}" %>
            <% if I18n.exists?(hint_key) -%>
              <p class="mt-2 text-sm text-gray-500">
                <%= I18n.t(hint_key) %>
              </p>
            <% end -%>
          </div>
        <% end %>
      </div>
    </div>
  <% end -%>

  <div class="flex items-center justify-end space-x-3 pt-6 border-t border-gray-200">
    <%= link_to(
      t("administrate.actions.cancel"),
      resource_show_path(page, page.resource),
      class: "administrate-button administrate-button--secondary"
    ) if accessible_action?(page.resource, :show) && page.resource.persisted? %>
    <%= f.submit class: "administrate-button" %>
  </div>
<% end %>
