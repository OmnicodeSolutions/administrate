<%#
# Show

This view is the template for the show page.
It renders the attributes of a resource,
as well as a link to its edit page.

## Local variables:

- `page`:
  An instance of [Administrate::Page::Show][1].
  Contains methods for accessing the resource to be displayed on the page,
  as well as helpers for describing how each attribute of the resource
  should be displayed.

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Show
%>

<% content_for(:title) { t("administrate.actions.show_resource", name: page.page_title) } %>

<!-- Header actions -->
<% content_for(:header_actions) do %>
  <div class="flex items-center gap-6">
    <%= link_to(
      t("administrate.actions.edit_resource", name: page.page_title),
      resource_edit_path(page, page.resource),
      class: "btn-white",
      data: { turbo_frame: "_top" }
    ) if accessible_action?(page.resource, :edit) %>

    <%= link_to(
      t("administrate.actions.destroy"),
      [namespace, page.resource],
      class: "btn-black",
      data: { 
        confirm: t("administrate.actions.confirm"),
        turbo_method: :delete
      }
    ) if accessible_action?(page.resource, :destroy) %>
  </div>
<% end %>

<div class="space-y-6">
  <!-- Page header -->
  <div class="border-b border-gray-200 pb-4">
    <h1 class="text-2xl font-bold text-gray-900"><%= content_for(:title) %></h1>
    <p class="mt-2 text-sm text-gray-600">
      <%= t("administrate.controller.show.subtitle", resource: display_resource_name(page.resource_name, singular: true)) %>
    </p>
  </div>

  <!-- Resource details -->
  <% page.attributes.each do |title, attributes| %>
    <div class="<%= 'administrate-card' if title.present? %>">
      <% if title.present? %>
        <h3 class="text-lg font-medium text-gray-900 mb-4 border-b border-gray-200 pb-2">
          <%= t "helpers.label.#{page.resource_name}.#{title}", default: title %>
        </h3>
      <% end %>

      <dl class="grid grid-cols-1 gap-x-4 gap-y-6">
        <% attributes.each do |attribute| %>
          <div class="attribute-group">
            <dt class="administrate-label" id="<%= attribute.name %>">
              <%= t(
                "helpers.label.#{resource_name}.#{attribute.name}",
                default: page.resource.class.human_attribute_name(attribute.name),
              ) %>
            </dt>
            <dd class="mt-1 text-sm text-gray-900 attribute-data--<%= attribute.html_class %>">
              <div class="<%= 'preserve-whitespace' if attribute.html_class == 'text' %>">
                <%= render_field attribute, page: page %>
              </div>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  <% end %>
</div>
